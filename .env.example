# ── Relay Outpost — environment ────────────────────────────────────────────
# Copy to `.env` and fill in. Only DATABASE_URL is required; every optional
# integration below degrades gracefully (returns HTTP 503) when left unset.

# Required — PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/relay_outpost

# Server runtime.
NODE_ENV=production
PORT=5000

# CORS — comma-separated list of origins allowed to call the API.
# Leave empty for local dev (localhost / 0.0.0.0 are auto-allowed).
# Set this to your domain(s) in production, e.g. https://relay.example.com
ALLOWED_ORIGINS=

# ── Optional integrations (features turn themselves off if unset) ───────────

# Podcast discovery tab — https://podcastindex.org
PODCAST_INDEX_API_KEY=
PODCAST_INDEX_API_SECRET=

# GIF search — KLIPY (Tenor-compatible)
KLIPY_API_KEY=

# Closed-beta access code, checked by POST /api/beta/verify. Unset = no code required.
BETA_ACCESS_CODE=

# Show the closed-beta gate on the landing page (client build-time flag). Unset/0 = gate
# off (public, the default). Set to 1 to require a code before "Launch Station" proceeds —
# pair with BETA_ACCESS_CODE above to run a private beta again.
VITE_BETA_GATE=

# NOTE: Web of Trust (GrapeRank/Brainstorm), profile search, and Nostr Archives
# are proxied to public services by default — no key needed. They are optional;
# run your own if you prefer. See the README "Run your own outpost" section.
